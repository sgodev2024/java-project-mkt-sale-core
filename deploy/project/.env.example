COMPOSE_PROJECT_NAME=crm-mkt-sale
APP_VERSION=local

POSTGRES_DB=crm_mkt_sale
DB_MIGRATION_USER=core_admin
DB_MIGRATION_PASSWORD=CHANGE_TO_RANDOM_MIGRATION_PASSWORD
DB_USER=core_app
DB_PASSWORD=CHANGE_TO_RANDOM_RUNTIME_PASSWORD
DB_POOL_SIZE=10

CORE_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_RANDOM_ONE_TIME_ADMIN_PASSWORD
CORE_CORS_ALLOWED_ORIGIN_PATTERNS=https://crm-mkt-sale.sgodata.com

# Để trống khi frontend và /api dùng chung một domain qua Nginx.
PUBLIC_API_URL=
BACKEND_HOST_PORT=18180
FRONTEND_HOST_PORT=18181
